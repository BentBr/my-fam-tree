{
    "name": "my-fam-tree-fe",
    "private": true,
    "version": "0.1.21",
    "type": "module",
    "scripts": {
        "dev": "vite --port 5173",
        "generate:images": "node scripts/generate-images.js",
        "generate:sitemap": "node scripts/generate-sitemap.js",
        "build": "pnpm run generate:images && vue-tsc --noEmit && vite-ssg build && pnpm run generate:sitemap",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "typecheck": "vue-tsc --noEmit",
        "openapi-codegen": "openapi-typescript ./openapi.json -o ./src/api/schema.d.ts",
        "test": "vue-tsc --noEmit && vitest run",
        "test:e2e": "playwright test -c e2e/playwright.config.ts",
        "knip": "knip",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@lucide/vue": "^1.70.0",
        "@tanstack/vue-query": "^5.107.1",
        "@unhead/vue": "^2.1.17",
        "d3-ease": "^3.0.2",
        "d3-selection": "^3.0.1",
        "d3-transition": "^3.0.2",
        "d3-zoom": "^3.0.1",
        "openapi-fetch": "^0.17.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.45",
        "vue-i18n": "^11.4.18",
        "vue-router": "^5.4.0",
        "vuetify": "^4.3.3"
    },
    "devDependencies": {
        "@playwright/experimental-ct-vue": "^1.62.1",
        "@playwright/test": "^1.65.0",
        "@types/d3-ease": "^3.0.2",
        "@types/d3-selection": "^3.0.12",
        "@types/d3-transition": "^3.0.9",
        "@types/d3-zoom": "^3.0.9",
        "@types/node": "^25.9.9",
        "@types/pg": "^8.23.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^4.1.12",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "knip": "^6.44.2",
        "openapi-typescript": "^7.13.0",
        "pg": "^8.23.1",
        "prettier": "^3.9.10",
        "sass-embedded": "^1.108.1",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.7",
        "vite-plugin-vuetify": "^2.1.3",
        "vite-ssg": "^28.3.0",
        "vitest": "^4.1.12",
        "vue-tsc": "^3.3.14"
    },
    "packageManager": "pnpm@10.33.4",
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp"
        ],
        "overrides": {
            "js-beautify>glob": "^14.0.2",
            "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
        }
    }
}
